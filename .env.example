# Required: use sk_test_... locally, then replace it with sk_live_... in production.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Must be a currency enabled on your Paystack account.
PAYSTACK_CURRENCY=USD

# Public production origin used for Paystack's callback URL.
SITE_URL=https://example.org

# Optional recurring plans. Keys are amounts in the currency subunit (2500 = 25.00).
# Create each monthly plan in Paystack first, then paste its PLN_... code here.
PAYSTACK_MONTHLY_PLANS={"2500":"PLN_replace_me","5000":"PLN_replace_me"}
